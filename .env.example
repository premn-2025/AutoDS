# Environment Configuration for AutoDS Pipeline
# Copy this to .env and fill in your actual values

# ======================
# Local LLM Settings (Ollama - Default)
# ======================
USE_LOCAL_MODEL=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Supported local models (install via: ollama pull <model>):
# - llama3.2 (default, 3B params, fast)
# - llama3.1 (8B params, better quality)
# - mistral (7B params, good balance)
# - codellama (code-specialized)
# - phi3 (small, fast)

# ======================
# Google Cloud Settings (Optional - set USE_LOCAL_MODEL=false to use)
# ======================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Vertex AI / Gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=your-gemini-api-key

# Cloud Storage
GCS_BUCKET=autods-data-bucket

# ======================
# Application Settings
# ======================
FLASK_ENV=development
FLASK_DEBUG=0
API_HOST=0.0.0.0
API_PORT=8080

# ======================
# Pipeline Settings
# ======================
MAX_PIPELINE_TIMEOUT=600
ENABLE_HYPERPARAMETER_TUNING=true
CROSS_VALIDATION_FOLDS=5
TEST_SIZE=0.2

# ======================
# Alerting Thresholds
# ======================
LLM_LATENCY_THRESHOLD=5.0
PIPELINE_FAILURE_THRESHOLD=3
DATA_QUALITY_MISSING_THRESHOLD=20
COST_THRESHOLD_HOURLY=50.0
